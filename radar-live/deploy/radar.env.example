# radar-live settings, read by BOTH systemd units (EnvironmentFile=).
# Installed as /etc/radar-live/radar.env, mode 0640 root:radar. Keep it private: it holds the keys.
# This example file contains PLACEHOLDERS ONLY (CHANGE_ME_*). install.sh generates the real keys on the
# host with `radar-db keygen`, writes them into /etc/radar-live/radar.env (never into the repo or dist/)
# and prints them once. Never commit a filled-in copy (.gitignore blocks *.env).
# Plain KEY=value lines only (no quotes, no "export", no inline comments).
#
# Secrets are environment variables only. There is NO command-line flag for a key or token (command
# lines show up in process lists); a flag such as --view-keys or --db-key stops the program with a
# message naming the variable. A key may also live in a file outside the repo whose PATH is given by a
# *_FILE variable (RADAR_VIEW_KEYS_FILE, RADAR_INGEST_KEYS_FILE, RADAR_FEED_KEY_FILE).
#
# Precedence inside the programs: command-line flag > environment > this env file > built-in default.
# The units only pass --listen (and --internal-listen for radar-db), taken from the RADAR_*_LISTEN lines below.

# ---- Key wiring (one shared ingest key is enough) ----------------------------------------------
# RADAR_INGEST_KEYS  radar-db accepts pings signed with it, radar-ingest accepts feeders signed
#                    with it (RADAR_FEED_KEY / RADAR_FEED_KEY_FILE on the gaming PC).
# RADAR_DB_KEY       the key radar-ingest sends to radar-db; must be one of RADAR_INGEST_KEYS.
# RADAR_VIEW_KEYS    what the web page and API readers must present (X-View-Key). Comma separated.
# Keys are >= 16 characters. Make more with: radar-db keygen
# install.sh replaces the CHANGE_ME_* placeholders below with freshly generated keys.
RADAR_INGEST_KEYS=CHANGE_ME_INGEST_KEY
RADAR_DB_KEY=CHANGE_ME_INGEST_KEY
RADAR_VIEW_KEYS=CHANGE_ME_VIEW_KEY
# Or keep keys in files instead (path only here; the files are 0600/0640, outside the repo):
# RADAR_VIEW_KEYS_FILE=/etc/radar-live/view.keys
# RADAR_INGEST_KEYS_FILE=/etc/radar-live/ingest.keys
# Tunnel token (cloudflared): do NOT keep it here (this file is readable by group radar). Put TUNNEL_TOKEN=... in
# /etc/cloudflared/tunnel.env, mode 0600 root:root (docs/security/hardening.md). RADAR_TUNNEL_TOKEN=CHANGE_ME_TUNNEL_TOKEN
# is only for a tunnel client that reads this file.

# ---- Network -----------------------------------------------------------------------------------
# radar-db: web page + read API. ":8787" = every interface (the LAN). Use 127.0.0.1:8787 to hide
# it behind Caddy or a Cloudflare Tunnel running on the same machine.
RADAR_DB_LISTEN=:8787
# radar-ingest: only the feeder talks to it. Loopback by default; use 0.0.0.0:8788 (or the LAN
# address) when radar-feed runs on another PC.
RADAR_INGEST_LISTEN=127.0.0.1:8788
# radar-db INTERNAL listener: serves only /internal/* (the write API) and /healthz. Keep it on
# loopback; never forward it through a tunnel or proxy.
RADAR_DB_INTERNAL_LISTEN=127.0.0.1:8789
# Where radar-ingest finds radar-db: the internal listener above.
RADAR_DB_URL=http://127.0.0.1:8789

# Zone map images (WebP + index.json), served read-only at /maps/. install.sh creates this folder and fills it from a
# dist/maps folder built with --with-maps / -WithMaps. Empty = off (the radar then shows only the grid).
# The images come from game data for personal use: they are not committed and not in the binary.
RADAR_MAPS_DIR=/var/lib/radar-live/maps

# ---- Limits (guard/limits; defaults shown, per listener) ---------------------------------------
# RADAR_LIMITS_MAX_CONNS=512
# RADAR_LIMITS_MAX_INFLIGHT=256
# Server timeouts: RADAR_LIMITS_READ_HEADER_TIMEOUT=5s RADAR_LIMITS_READ_TIMEOUT=15s
# RADAR_LIMITS_WRITE_TIMEOUT=30s RADAR_LIMITS_IDLE_TIMEOUT=60s RADAR_LIMITS_STREAM_IDLE_TIMEOUT=60s
# RADAR_LIMITS_MAX_HEADER_BYTES=16384

# ---- Rate limits (guard/ratelimit; defaults shown; rates are requests per MINUTE) -------------------
# RADAR_RATELIMIT_ENABLED=true            kill switch; false disables all rate limiting
# Per client address (IPv6 is counted per /64): RATE refills per minute, BURST is the bucket size.
# RADAR_RATELIMIT_PAGE_RATE=120      RADAR_RATELIMIT_PAGE_BURST=60       page + static assets
# RADAR_RATELIMIT_SWEEP_RATE=30      RADAR_RATELIMIT_SWEEP_BURST=15      the polled sweep query
# RADAR_RATELIMIT_SEARCH_RATE=60     RADAR_RATELIMIT_SEARCH_BURST=30     contacts, trail, bounty, charts
# RADAR_RATELIMIT_WRITE_RATE=1200    RADAR_RATELIMIT_WRITE_BURST=400     /internal write API, per address
# RADAR_RATELIMIT_WRITE_KEY_RATE=600 RADAR_RATELIMIT_WRITE_KEY_BURST=200 ... and per API key
# RADAR_RATELIMIT_INGEST_RATE=1200   RADAR_RATELIMIT_INGEST_BURST=400    /v1/stream, /v1/lines, per address
# RADAR_RATELIMIT_INGEST_KEY_RATE=600 RADAR_RATELIMIT_INGEST_KEY_BURST=200 ... and per API key
# RADAR_RATELIMIT_AUTHFAIL_RATE=10   RADAR_RATELIMIT_AUTHFAIL_BURST=10   failed key attempts per address
# RADAR_RATELIMIT_MAX_ENTRIES=100000      tracked identities; when full, newcomers share one global bucket
# RADAR_RATELIMIT_TTL=10m                 forget an idle identity after this long
# RADAR_RATELIMIT_HEADERS=false           true adds X-RateLimit-Limit/Remaining/Reset
# Reverse proxies whose CF-Connecting-IP / X-Forwarded-For is believed. DEFAULT NONE (the TCP peer is
# used). With a Cloudflare Tunnel or Caddy running on THIS machine, trust loopback so visitors are
# told apart instead of all appearing as 127.0.0.1:
# RADAR_RATELIMIT_TRUSTED_PROXIES=127.0.0.1/32,::1/128
# Only do this when the public listener is NOT also reachable directly, or clients could spoof headers.
# TUNNEL / PROXY MODE in one place (docs/security/hardening.md): RADAR_DB_LISTEN=127.0.0.1:8787,
# RADAR_RATELIMIT_TRUSTED_PROXIES=127.0.0.1/32, RADAR_HEADERS_HSTS=true, RADAR_REQUIRE_KEYS=true.

# ---- Key guessing lockout (guard/abuse; defaults shown) ----------------------------------------------
# RADAR_ABUSE_ENABLED=true                kill switch
# RADAR_ABUSE_MAX_FAILURES=5              failed key attempts ...
# RADAR_ABUSE_WINDOW=10m                  ... within this window ban the client address
# RADAR_ABUSE_BAN_BASE=1m                 first ban; doubles with every further ban
# RADAR_ABUSE_BAN_MAX=24h                 longest ban
# RADAR_ABUSE_MAX_ENTRIES=10000           tracked addresses (memory bound)
# Ban list file. Default: abuse-bans.json beside the database file (radar-db). Set it for ONE service only:
# radar-ingest and radar-db share this env file but must not share a ban file, so leave it unset here and give
# radar-ingest its own through a systemd drop-in if you want its bans to survive restarts.
# RADAR_ABUSE_BAN_FILE=/var/lib/radar-live/abuse-bans.json
# Forwarded client addresses are believed from these proxies only (default: RADAR_RATELIMIT_TRUSTED_PROXIES).
# RADAR_ABUSE_TRUSTED_PROXIES=
# RADAR_ABUSE_BAN_LOOPBACK=false          loopback clients are never banned unless true
# RADAR_ABUSE_INTERNAL_ALLOW=             extra CIDRs allowed on the internal listener (default loopback only)
# Manage bans:  radar-db guard list | unban <ip> | ban <ip> <duration>

# ---- Startup policy -----------------------------------------------------------------------------
# RADAR_REQUIRE_KEYS: refuse to start when a role in use has no key. auto (default) = refuse unless every
# listener is bound to loopback; true = always refuse; false = accept an open API on purpose.
# RADAR_REQUIRE_KEYS=auto

# ---- Storage -----------------------------------------------------------------------------------
RADAR_DB_PATH=/var/lib/radar-live/radar-live.db
# SQLite page cache per connection, MiB (default 16).
RADAR_CACHE_MB=16
# RADAR_MAX_FIXES=250000

# ---- Behaviour ---------------------------------------------------------------------------------
# Ruleset used when a request has none: normal | pvp | rp | rppvp
# RADAR_DEFAULT_RULESET=pvp
# IANA time zone of log timestamps that carry no UTC offset (radar-ingest).
# RADAR_LOGPARSE_ZONE=America/New_York
# Allow another site to call the API from a browser (radar-db). Empty = off.
# Comma-separated exact origins (scheme://host[:port]); "*" is never honoured.
# RADAR_CORS_ORIGINS=https://radar.example.invalid

# ---- Other settings (defaults shown; both programs unless noted) -------------------------------------
# RADAR_ENV_FILE=              path of an extra KEY=value file (same format as this one)
# RADAR_LISTEN=:8787           listen address (the units pass --listen from the RADAR_*_LISTEN lines above)
# RADAR_INTERNAL_LISTEN=127.0.0.1:8789   radar-db internal listener (see RADAR_DB_INTERNAL_LISTEN above)
# RADAR_MAX_BODY=8388608       request body cap, bytes
# RADAR_SHUTDOWN_TIMEOUT=10s   graceful shutdown allowance
# RADAR_STORE=sqlite           sqlite | memstore (radar-db; flag or environment only)
# RADAR_DB_MAX_MB=2048         database size cap, MiB (pings get 507 above it)
# RADAR_DB_MIN_FREE_MB=200     pause pings when the data directory has less free space, MiB
# RADAR_DB_INTEGRITY_EVERY=24h interval of the full integrity_check (0 disables)
# RADAR_QUERY_TIMEOUT=5s       per-request store query timeout (radar-db)
# RADAR_SITE_DIR=              serve the page from this directory (development only)
# RADAR_HEADERS_HSTS=false     send Strict-Transport-Security (only when served over HTTPS)
# RADAR_HEADERS_API_ORIGINS=   extra API origins the page may call (CSP connect-src)
# RADAR_SECURITY_CONTACT=      published at /.well-known/security.txt; a contact such as mailto:security@example.invalid
# radar-ingest relay to radar-db:
# RADAR_RELAY_BUFFER_PINGS=5000 RADAR_RELAY_BUFFER_BYTES=67108864 RADAR_RELAY_BATCH_PINGS=50
# RADAR_RELAY_TIMEOUT=10s RADAR_RELAY_BACKOFF_MIN=500ms RADAR_RELAY_BACKOFF_MAX=30s
# radar-ingest log parsing:
# RADAR_LOGPARSE_WINDOW=24h RADAR_LOGPARSE_ALLOW_REPLAY=false
# RADAR_CONTACTX_FLUSH=10s RADAR_CONTACTX_RULESET=pvp RADAR_CONTACTX_TRACK_NPCS=false RADAR_CONTACTX_REALM_SUFFIX=
# RADAR_BOUNTYX_FLUSH=10s RADAR_BOUNTYX_RULESET=pvp RADAR_BOUNTYX_REALM_SUFFIX=
# radar-ingest stream limits:
# RADAR_STREAM_IDLE=2m RADAR_MAX_SOURCES=16 RADAR_STREAM_MAX_BYTES=4294967296
# RADAR_LINES_MAX_LINES=20000 RADAR_LINES_MAX_BYTES=8388608
# RADAR_STREAM_LINE_RATE=5000 RADAR_STREAM_LINE_BURST=10000 RADAR_STREAM_BYTE_RATE=4194304 RADAR_STREAM_BYTE_BURST=8388608
# RADAR_STREAM_KEY_LINE_RATE=20000 RADAR_STREAM_KEY_LINE_BURST=40000 RADAR_STREAM_KEY_BYTE_RATE=16777216 RADAR_STREAM_KEY_BYTE_BURST=33554432
# RADAR_STREAM_RATE_PATIENCE=30s RADAR_STREAM_MAX_PER_KEY=4 RADAR_STREAM_MAX_STREAMS=32 RADAR_STREAM_LINE_TIMEOUT=30s

# ---- Security log and alerts (guard/audit; both programs) ---------------------------------------------
# RADAR_AUDIT_LOG=             security log file (JSON lines, 0600, rotated); empty = stderr/journald
# RADAR_AUDIT_MAX_MB=10 RADAR_AUDIT_KEEP=5 RADAR_AUDIT_SAMPLE=1m
# RADAR_ALERT_CMD=             command run on alerts (no shell). Secret: environment only, there is no flag, since it may carry a
#                              webhook token. Keep any token it needs in the environment, not in the repo.
# RADAR_ALERT_BANS=5 RADAR_ALERT_WINDOW=10m RADAR_ALERT_RELAY_DROPS=100 RADAR_ALERT_COOLDOWN=5m

# ---- radar-armory: nightly armory sync (radar-armory.timer; docs/armory.md) -----------------------------------
# One run per night at 00:00 against the Battle.net WoW Classic Profile API (OAuth2 client credentials). The timer is
# enabled by install.sh only when BOTH secret files below exist and the db key is set.
# The client id and the client secret are NEVER written here. Put each in its own file (docs/armory.md has the
# hidden-typing recipe) and give only the PATHS. WOW_ARMORY_CLIENT_ID and WOW_ARMORY_API_KEY (the client SECRET) are the
# only secret names without the RADAR_ prefix (user-mandated; docs/security/secrets-policy.md). Setting the plain
# variables here is NOT recommended: this file is also read by radar-db and radar-ingest.
WOW_ARMORY_CLIENT_ID_FILE=/etc/radar-live/secrets/armory-client-id
WOW_ARMORY_API_KEY_FILE=/etc/radar-live/secrets/armory-api-key
# Key radar-armory sends to radar-db's internal listener; must be one of RADAR_INGEST_KEYS (install.sh fills it in).
# Alternative: RADAR_ARMORY_DB_KEY_FILE=/etc/radar-live/secrets/armory-db-key (path only).
RADAR_ARMORY_DB_KEY=CHANGE_ME_INGEST_KEY
# Realm (slug form: lowercase, hyphens) for crawl seeds that carry no realm; without it such seeds are skipped.
# RADAR_ARMORY_DEFAULT_REALM=your-realm-slug
# Everything below is optional. Defaults shown. Endpoint, namespace and field details are PROVISIONAL (unverified,
# community-sourced; see internal/mod/armoryclient/mapping.go). Paths use {realmSlug}, {characterName}, {guildSlug}.
# RADAR_ARMORY_REGION=us                   Battle.net region: us | eu | kr | tw
# RADAR_ARMORY_BASE_URL=                   https API base; default https://REGION.api.blizzard.com
# RADAR_ARMORY_NAMESPACE=                  PROVISIONAL, default profile-classic-REGION (which namespace WoW Forever uses is unverified)
# RADAR_ARMORY_ROSTER_NAMESPACE=           PROVISIONAL, namespace of the guild roster call; default: the namespace above
# RADAR_ARMORY_LOCALE=en_US
# RADAR_ARMORY_TOKEN_URL=                  OAuth2 token endpoint; default https://oauth.battle.net/token
# RADAR_ARMORY_SUMMARY_PATH=               PROVISIONAL, default /profile/wow/character/{realmSlug}/{characterName}
# RADAR_ARMORY_EQUIPMENT_PATH=             PROVISIONAL, default .../equipment
# RADAR_ARMORY_SPECS_PATH=                 PROVISIONAL, default .../specializations
# RADAR_ARMORY_STATS_PATH=                 PROVISIONAL, default .../statistics
# RADAR_ARMORY_PVP_PATH=                   PROVISIONAL, default .../pvp-summary
# RADAR_ARMORY_ROSTER_PATH=                PROVISIONAL, default /data/wow/guild/{realmSlug}/{guildSlug}/roster
# RADAR_ARMORY_SEED_PAGE_SIZE=200          seeds per request to radar-db (1..500)
# RADAR_ARMORY_MAX_GUILD_MEMBERS=1000      roster members crawled per guild (1..10000)
# RADAR_ARMORY_RATE=5                      armory requests per second (keep below the client's quota)
# RADAR_ARMORY_CONCURRENCY=3               parallel character fetches (1..64)
# RADAR_ARMORY_MAX_REQUESTS=0              request budget per run, 0 = unlimited
# RADAR_ARMORY_MAX_RUNTIME=6h              wall-clock budget per run; radar-armory.service TimeoutStartSec is this + 30min
# RADAR_ARMORY_DB_URL=http://127.0.0.1:8789   radar-db INTERNAL listener (https, or http on loopback only)
# RADAR_ARMORY_LOCATION=Local              IANA zone for the same-day resume window

# ---- Gaming PC programs (NOT read from this file on the server; set in the PC's own environment) --------
# radar-feed:   RADAR_FEED_KEY (or RADAR_FEED_KEY_FILE = path of a file holding the key), RADAR_FEED_INGEST_URL,
#               RADAR_FEED_LOGS, RADAR_FEED_SOURCE, RADAR_FEED_RS
# radar-client: RADAR_CLIENT_INGEST_KEY (memory only, never saved to disk), RADAR_CLIENT_SERVER

# ---- Go runtime, tuned for a weak laptop -------------------------------------------------------
GOMAXPROCS=2
GOMEMLIMIT=96MiB
