{
  "name": "radar-cloud",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "tsc",
    "synth": "cdk synth",
    "deploy": "cdk deploy",
    "test": "node --test test/api.test.mjs && node --require ts-node/register --test test/stack.test.ts && node --test test/site/*.test.js",
    "dev": "node dev/server.mjs --demo",
    "dev:sim": "node dev/server.mjs --demo --sim --fresh",
    "smoke": "node dev/smoke.mjs",
    "sample-log": "node dev/make-sample-log.cjs"
  },
  "devDependencies": {
    "aws-cdk": "^2.170.0",
    "aws-cdk-lib": "^2.170.0",
    "constructs": "^10.4.2",
    "typescript": "~5.6.0",
    "ts-node": "^10.9.2",
    "@types/node": "^22.0.0",
    "@aws-sdk/client-dynamodb": "^3.700.0",
    "@aws-sdk/lib-dynamodb": "^3.700.0"
  },
  "dependencies": {
    "aws-cdk-lib": "^2.170.0",
    "constructs": "^10.4.2"
  }
}
